{
  "name": "svelte-bench",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@cursor/sdk": "^1.3.1",
    "@google/genai": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "jsdom": "^31.0.0",
    "openai": "^7.53.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "pnpm run-tests && pnpm build",
    "tui": "node tui/run.mjs",
    "tui:build": "mkdir -p bin && cd tui && go build -o ../bin/svelte-bench-tui ./cmd/tui",
    "run-tests": "tsx ./index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm merge && tsx ./build-static.ts",
    "build-v1": "tsx ./merge-v1.ts && tsx ./build-static.ts",
    "verify": "tsx ./verify.ts",
    "ollama-test": "./ollama-test.sh",
    "ollama-tps": "tsx ./ollama-tps.ts",
    "ollama-token-times": "tsx ./ollama-token-times.ts",
    "merge": "tsx ./merge.ts",
    "merge-v1": "tsx ./merge-v1.ts",
    "open": "node -e \"require('child_process').spawn('open', ['benchmarks/benchmark-results-merged.html'], { stdio: 'inherit' })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cost:report": "tsx scripts/api-cost-report.ts",
    "cost:prices": "tsx scripts/refresh-api-prices.ts",
    "cost:reconcile": "tsx scripts/reconcile-api-cost.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "ollama": "^0.6.4",
    "rimraf": "^6.1.4",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "undici": "^8.12.4",
    "vite": "^8.3.6"
  }
}
